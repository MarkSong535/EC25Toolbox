#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from ec25toolbox_linux.config import ConfigurationError, load_config
from ec25toolbox_linux.voice import run_agi


try:
    app_config = load_config("/etc/ec25toolbox/config.toml")
except ConfigurationError:
    raise SystemExit(1)

raise SystemExit(run_agi(app_config, sys.argv[1:]))
