diff --git a/cpvt.c b/cpvt.c
index 7d326e6..ede00fb 100644
--- a/cpvt.c
+++ b/cpvt.c
@@ -111,6 +111,11 @@ EXPORT_DEF void cpvt_free(struct cpvt* cpvt)
 
 	if(PVT_NO_CHANS(pvt)) {
 		pvt_on_remove_last_channel(pvt);
+		/* Reading SMS while voice commands are active can corrupt the modem
+		 * command queue. CMTI/CDSI handlers retain those indexes in the inbox;
+		 * start retrieval only after the last call channel has gone away. */
+		if (pvt->incoming_sms_index == -1U)
