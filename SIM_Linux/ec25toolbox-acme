#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))

from ec25toolbox_linux.acme import deploy_certificate, issue_certificate, renew_certificate
from ec25toolbox_linux.config import ConfigurationError, load_config


def main() -> int:
    parser = argparse.ArgumentParser(description="Issue or deploy the EC25 SIP TLS certificate")
    parser.add_argument("action", choices=("issue", "renew", "deploy"))
    parser.add_argument("--config", default="/etc/ec25toolbox/config.toml")
    parser.add_argument("--lineage", help="Certbot lineage directory; deploy hooks normally use RENEWED_LINEAGE")
    arguments = parser.parse_args()
    try:
        config = load_config(arguments.config)
        if arguments.action == "issue":
            issue_certificate(config)
        elif arguments.action == "renew":
            renew_certificate(config)
        else:
            deploy_certificate(config, arguments.lineage or os.environ.get("RENEWED_LINEAGE"))
    except (ConfigurationError, KeyError, OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"ACME error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
